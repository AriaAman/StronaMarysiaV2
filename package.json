{
  "name": "pietruszczak-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @pietruszczak/site",
    "dev": "npm run dev --workspace @pietruszczak/site",
    "generate": "npm run generate --workspace @pietruszczak/site",
    "preview": "npm run preview --workspace @pietruszczak/site",
    "site:build": "npm run build --workspace @pietruszczak/site",
    "site:dev": "npm run dev --workspace @pietruszczak/site",
    "admin:build": "npm run build --workspace @pietruszczak/admin",
    "admin:dev": "npm run dev --workspace @pietruszczak/admin"
  }
}
